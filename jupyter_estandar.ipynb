    "# normalizar materiales \n",
    "MAP_MATERIAL = {\n",
    "    \"plastico\": [\"plastico\",\"plastica\",\"plasticos\",\"plasticas\",\"polietileno\",\"acrilico\"],\n",
    "    \"metal\": [\"metal\",\"metalico\",\"acero\",\"aluminio\",\"hierro\",\"fierro\"],\n",
    "    \"natural\": [\"madera\",\"bambu\",\"ratan\",\"fibra natural\"],\n",
    "    \"vidrio\": [\"vidrio\"],\n",
    "    \"ceramica\": [\"ceramica\",\"porcelana\",\"greda\",\"arcilla\"],\n",
    "    \"cementicio\": [\"cemento\",\"fiberclay\",\"fiber clay\"],\n",
    "}\n",
    "def extraer_material(texto):\n",
    "    if not isinstance(texto, str):\n",
    "        return None\n",
    "    \n",
    "    texto = texto.lower()\n",
    "\n",
    "    for categoria, palabras in MAP_MATERIAL.items():\n",
    "        patron = r\"\\b(\" + \"|\".join(palabras) + r\")\\b\"\n",
    "        if re.search(patron, texto):\n",
    "            return categoria   # devuelve la CLASE, no la palabra\n",
    "    \n",
    "    return None\n",
    "\n",
    "df['Material'] = df['Producto'].apply(extraer_material).str.upper()\n",
    "df['Material'] = df['Material'].fillna(\"DESCONOCIDO\")\n",
    "\n",
    "print(df.head(10))"
   ]
  },
