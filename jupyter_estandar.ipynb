    "import re\n",
    "# variable medida\n",
    "def extraer_medida(texto):\n",
    "    patron_cm = r\"\\d+(?:[.,]\\d+)?(?:(?:\\s*x\\s*\\d+(?:[.,]\\d+)?){1,2}|\\s*(cm|pulgadas))\"\n",
    "    patron_talla = r\"\\b(XXL|XL|L|M|S)\\b\"\n",
    "    patron_litros = r\"\\d+(?:[.,]\\d+)?\\s*(?:l|lt|litro|litros)\"\n",
    "\n",
    "    m = re.search(patron_cm, texto, re.IGNORECASE)\n",
    "    if m:\n",
    "        return m.group().replace(\" \",\"\")\n",
    "\n",
    "    m = re.search(patron_litros, texto, re.IGNORECASE)\n",
    "    if m:\n",
    "        return m.group().replace(\" \",\"\")\n",
    "\n",
    "    m = re.search(patron_talla, texto)\n",
    "    if m:\n",
    "        return m.group()\n",
    "    \n",
    "    return None\n",
    "\n",
    "\n",
    "df[\"Medidas\"] = df[\"Producto\"].apply(extraer_medida)\n",
    "df['Medidas'] = df['Medidas'].fillna('SIN MEDIDAS')\n",
    "\n",
    "print(df.head())"
   ]
  },
