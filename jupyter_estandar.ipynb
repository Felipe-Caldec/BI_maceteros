    "import re\n",
    "def extraer_cantidad(texto):\n",
    "    patron_pack = r\"(?:packs|pack|set)\\s*(?:de|x)?\\s*(\\d+)\\s*\"\n",
    "    patron_unidades = r\"(\\d+)\\s*(?:de|x)?\\s*(?:unidades|und|unid.|pcs|pcsx|macetas|maceteros|soporte|soportes|pz)\"\n",
    "    \n",
    "    m1 = re.search(patron_pack, texto, re.IGNORECASE)\n",
    "    if m1:\n",
    "        return int(m1.group(1))\n",
    "\n",
    "    m2 = re.search(patron_unidades, texto, re.IGNORECASE)\n",
    "    if m2:\n",
    "        return int(m2.group(1))\n",
    "    return None\n",
    "\n",
    "\n",
    "df['Cantidad'] = df['Producto'].apply(extraer_cantidad)\n",
    "df['Cantidad'] = df['Cantidad'].astype(\"Int64\")\n",
    "df['Cantidad'] = df['Cantidad'].fillna(1)\n",
    "print(df.head(10))"
   ]
